{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/train/human-process.schema.json",
  "title": "CUMCM human process intake V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "title", "intake_status", "human_supplies", "questions", "source_files", "external_input_note"],
  "properties": {
    "schema_version": { "const": 3 },
    "package_id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "intake_status": { "const": "intake" },
    "human_supplies": { "const": ["source", "process"] },
    "questions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/questionId" } },
    "source_files": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sourcePath" } },
    "external_input_note": { "type": "string" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "questionId": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$" },
    "sourcePath": { "allOf": [{ "$ref": "#/$defs/relativePath" }, { "pattern": "^source/" }] }
  }
}
